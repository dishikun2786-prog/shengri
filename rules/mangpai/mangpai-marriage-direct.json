[
  {
    "rule_id": "mangpai_marriage_direct_001",
    "name": "男命日支比劫-克妻再娶",
    "version": "1.0.0",
    "module": "mangpai_marriage_direct",
    "priority": 95,
    "conditions": {
      "operator": "AND",
      "rules": [
