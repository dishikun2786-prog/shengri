# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shengri?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d

# Calendar Engine
CALENDAR_ENGINE_URL=http://localhost:8100

# AI - MiniMax (默认)
MINIMAX_API_KEY=eyJxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/v1/text/chatcompletion_v2
MINIMAX_MODEL=MiniMax-M2.5

# AI - OpenAI (备选)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# AI - DeepSeek (备选)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 默认AI提供商 (minimax / openai / deepseek)
DEFAULT_AI_PROVIDER=minimax

# API Key 加密密钥（生产环境请更换）
ENCRYPTION_KEY=change-this-in-production

# WeChat Pay V3
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_SERIAL_NO=
WECHAT_PRIVATE_KEY_PATH=./certs/wechat/apiclient_key.pem
WECHAT_API_V3_KEY=
WECHAT_NOTIFY_URL=https://yourdomain.com/api/v1/payment/wechat/notify

# Alipay
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://yourdomain.com/api/v1/payment/alipay/notify
ALIPAY_RETURN_URL=https://yourdomain.com/payment/result

# Qdrant (Mem0 Vector DB)
QDRANT_URL=http://localhost:6333

# Mem0 LLM (provider=openai works with any OpenAI-compatible API)
MEM0_LLM_PROVIDER=openai
MEM0_LLM_MODEL=deepseek-v4-flash

# Mem0 Embedding - 需要真正的嵌入模型
# 方案A: Ollama 本地嵌入 (免费) → MEM0_EMBEDDING_PROVIDER=ollama, MODEL=nomic-embed-text
# 方案B: OpenAI 嵌入 (付费) → MEM0_EMBEDDING_PROVIDER=openai, MODEL=text-embedding-3-small
MEM0_EMBEDDING_PROVIDER=openai
MEM0_EMBEDDING_MODEL=text-embedding-3-small
MEM0_EMBEDDING_API_KEY=
MEM0_EMBEDDING_BASE_URL=https://api.openai.com/v1

# WebSocket
WS_CORS_ORIGIN=http://localhost:3001

# Web
WEB_BASE_URL=http://localhost:3001

# App
PORT=3000
NODE_ENV=development
